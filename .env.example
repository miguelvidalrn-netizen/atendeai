# ----------------------------------------------------------------------------
# Banco de dados (obrigatório)
# ----------------------------------------------------------------------------
# String de conexão PostgreSQL. Funciona com Neon, Supabase, Vercel Postgres,
# Railway ou um Postgres local.
DATABASE_URL="postgresql://usuario:senha@host:5432/atendeai?schema=public"

# ----------------------------------------------------------------------------
# Autenticação (obrigatório)
# ----------------------------------------------------------------------------
# Chave usada pelo NextAuth para assinar as sessões.
# Gere uma com: openssl rand -base64 32
AUTH_SECRET="troque-por-uma-chave-secreta-de-32-bytes"

# URL pública da aplicação.
# Em produção na Vercel: https://seu-projeto.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Provedor de IA (opcional)
# ----------------------------------------------------------------------------
# Sem AI_API_KEY o app usa um provedor simulado (mock) e marca visualmente
# todas as respostas como simuladas. Nenhuma dessas variáveis tem o prefixo
# NEXT_PUBLIC_ — elas nunca chegam ao navegador.
# AI_API_KEY=""
# AI_MODEL="claude-sonnet-4-6"
